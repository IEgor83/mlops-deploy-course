# Окружение
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Данные и модели — в DVC, не в Git.
# Игнорируем содержимое, но НЕ указатели DVC: .dvc-файлы обязаны ехать
# в Git, иначе `dvc add` падает с "bad DVC file name ... is git-ignored".
/data/**
!/data/**/
!/data/**/*.dvc
!/data/README.md
/models/**
!/models/**/
!/models/**/*.dvc

# Метрики и отчёты — маленькие, их держим в Git:
# так работают `dvc metrics diff` и сравнение между коммитами
/reports/*
!/reports/.gitkeep
!/reports/*.json
!/reports/*.md

# MLflow локальный бэкенд
mlruns/
mlartifacts/
mlflow.db

# Секреты
.env
*.pem
*.key

# IDE / ОС
.idea/
.vscode/
.DS_Store
