{
  "title": "Churn Service",
  "uid": "churn-service",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Модель загружена",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "model_loaded", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Запросы в секунду",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum by (endpoint) (rate(prediction_requests_total[1m]))", "legendFormat": "{{endpoint}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Доля ошибок",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(prediction_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(prediction_requests_total[5m])), 0.001)",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Медиана предсказанной вероятности (индикатор дрейфа)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(prediction_probability_bucket[10m])) by (le))", "legendFormat": "median proba", "refId": "A" }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
