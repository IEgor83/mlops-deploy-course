# Секреты живут здесь; сам .env — в .gitignore.
# В репозиторий едет только этот файл с именами переменных без значений.

MLFLOW_TRACKING_URI=http://localhost:5000

# Доступ к S3-совместимому хранилищу артефактов (MinIO)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# Пароли стенда docker-compose
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=
